# Copy to .env and adjust locally. Never commit real secrets.

# --- Backend ---
APP_NAME=AI Business Automation Platform
ENVIRONMENT=development
API_HOST=0.0.0.0
API_PORT=8000
# Used in later phases. Health check does not require a live database.
DATABASE_URL=postgresql+psycopg://app:app@localhost:5432/app
REDIS_URL=redis://localhost:6379/0
CORS_ORIGINS=http://localhost:3000
# Generate a unique value in your local .env. Do not use this placeholder in production.
SECRET_KEY=replace-with-a-long-random-local-secret

# --- Frontend ---
NEXT_PUBLIC_API_URL=http://localhost:8000
