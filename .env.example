# Copy to .env and adjust locally. Never commit real secrets.

# --- Backend ---
APP_NAME=FlowPilot
ENVIRONMENT=development
API_HOST=0.0.0.0
API_PORT=8000
DATABASE_URL=postgresql+psycopg://app:app@localhost:5432/app
REDIS_URL=redis://localhost:6379/0
# Comma-separated browser origins. Local Next.js may use 3001 if 3000 is taken.
CORS_ORIGINS=http://localhost:3000,http://localhost:3001
# Generate a unique value in your local .env. Production requires a secret of at least 32 characters.
SECRET_KEY=replace-with-a-long-random-local-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# AI is used only through the AIProvider abstraction. Unit tests never call a
# real model. Do not commit real keys. openai remains the default so existing
# OpenAI-only .env files keep working without AI_PROVIDER or GROQ_* vars.
# Load this file at the repository root (or optionally backend/.env). Paths are
# resolved from the config module, not the process working directory.
# openai_request_timeout_seconds (OPENAI_REQUEST_TIMEOUT_SECONDS) is still the
# shared AI request timeout; a rename is deferred to a later cleanup.
AI_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
# Maximum model→tool→model rounds per agent execution. Prevents unbounded loops.
AGENT_MAX_TOOL_ITERATIONS=3
# RUNNING executions older than this many seconds may be recovered as FAILED
# when history/start/run is next requested for that agent. Effective timeout is
# max(this value, (AGENT_MAX_TOOL_ITERATIONS + 1) * OpenAI request timeout).
AGENT_EXECUTION_STALE_TIMEOUT_SECONDS=300
# RUNNING sales runs older than this may be recovered as FAILED. Effective
# timeout is max(this value, 2 * OpenAI request timeout) so both qualification
# and draft generation can finish.
SALES_RUN_STALE_TIMEOUT_SECONDS=300

# Transactional email (Resend). Sending approved lead replies is explicit and
# human-triggered. Leave empty locally; tests never send real email.
EMAIL_PROVIDER=resend
RESEND_API_KEY=
EMAIL_FROM_ADDRESS=
EMAIL_FROM_NAME=FlowPilot
EMAIL_REQUEST_TIMEOUT_SECONDS=30
# RUNNING follow-up executions older than this may be recovered as FAILED.
# Effective timeout is max(this value, EMAIL_REQUEST_TIMEOUT_SECONDS).
LEAD_FOLLOW_UP_EXECUTION_STALE_TIMEOUT_SECONDS=300

# --- Follow-up worker (separate process) ---
# Sends due EMAIL_FOLLOW_UP records automatically. Run it with
# `python -m app.worker`; the API process never starts it. Disabled by default
# so a local API server never sends customer email unexpectedly. Delivery is
# at-least-once, protected by the provider idempotency key. There are no
# automatic retries: a FAILED execution leaves the follow-up PENDING.
FOLLOW_UP_WORKER_ENABLED=false
FOLLOW_UP_WORKER_POLL_INTERVAL_SECONDS=30
FOLLOW_UP_WORKER_BATCH_SIZE=10

# --- Sales Agent auto-start worker (same process as follow-up worker) ---
# Claims PENDING website leads and starts the existing Sales Agent pipeline.
# Run it with `python -m app.worker`; the API process never starts it. Disabled
# by default so a local API server never calls the model for website enquiries.
SALES_AGENT_AUTO_START_WORKER_ENABLED=false
SALES_AGENT_AUTO_START_WORKER_POLL_INTERVAL_SECONDS=30
SALES_AGENT_AUTO_START_WORKER_BATCH_SIZE=10

# Public website enquiry capture. In-process sliding window per organization
# slug + client IP. This is single-instance protection only and does not use
# Redis. Capture remains off until an OWNER or ADMIN enables it.
WEBSITE_CAPTURE_RATE_LIMIT_MAX=5
WEBSITE_CAPTURE_RATE_LIMIT_WINDOW_SECONDS=60

# --- Frontend ---
NEXT_PUBLIC_API_URL=http://localhost:8000
