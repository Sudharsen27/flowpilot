# Local: browser talks to the API directly.
NEXT_PUBLIC_API_URL=http://localhost:8000

# Production (Vercel): leave NEXT_PUBLIC_API_URL empty or set same-origin, and
# set API_PROXY_TARGET to the Render origin so /api is rewritten same-origin.
# API_PROXY_TARGET=https://flowpilot-backend-product.onrender.com
# NEXT_PUBLIC_API_URL=same-origin
